# ============================================================
# TLS Trainer — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Node environment
NODE_ENV=production

# ── Database (Turso / libSQL) ────────────────────────────────
# Get from: https://turso.tech → your database → Connect
DATABASE_URL=libsql://YOUR-DB-NAME.turso.io
DATABASE_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN

# If DATABASE_URL is not set, server falls back to:
# packages/web/fallback.db (local SQLite — data will not persist across deploys)

# ── S3 / Object Storage ──────────────────────────────────────
# Optional — used for file upload storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_KEY

# ── AI Gateway ───────────────────────────────────────────────
# Used for the TLS AI Assistant chat feature
AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT/YOUR_GATEWAY/
AI_GATEWAY_API_KEY=YOUR_AI_GATEWAY_API_KEY

# ── Auth ─────────────────────────────────────────────────────
BETTER_AUTH_SECRET=generate-a-random-32-char-secret
AUTUMN_SECRET_KEY=

# ── Server / Site ────────────────────────────────────────────
PORT=3000
WEBSITE_URL=https://your-domain.com

# ── Runable Platform (if deploying on Runable) ───────────────
RUNABLE_AUTH_ISSUER=
RUNABLE_AUTH_CLIENT_ID=
RUNABLE_AUTH_CLIENT_SECRET=
RUNABLE_URL=

# ── Admin Panel ──────────────────────────────────────────────
# Password for accessing /admin
# Default fallback if not set: TLS@Admin2025 (CHANGE THIS IN PRODUCTION!)
ADMIN_PASSWORD=your-secure-admin-password

# ── Telegram Notifications ───────────────────────────────────
# Optional — sends trainee activity alerts to a Telegram chat
# Set TELEGRAM_ENABLED=true to activate
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
