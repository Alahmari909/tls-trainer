# TLS Trainer — Environment Variables
# Copy this file to .env and fill in all required values before running.
# NEVER commit the real .env file to version control.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
WEBSITE_URL=https://your-domain.com

# ── Database (Turso / libsql) ─────────────────────────────────────────────────
# Create a free database at https://turso.tech
# Then run: turso db show <db-name> --url  and  turso db tokens create <db-name>
DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token-here

# ── Admin Panel ───────────────────────────────────────────────────────────────
# Choose a strong password — this is the only credential for /admin
ADMIN_PASSWORD=change-me-strong-password

# ── Telegram Notifications (optional) ────────────────────────────────────────
# Create a bot via @BotFather on Telegram, get the chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# ── S3 / Object Storage (optional — for file uploads) ─────────────────────────
# Compatible with Cloudflare R2, AWS S3, or any S3-compatible provider
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# ── AI Gateway (optional) ─────────────────────────────────────────────────────
AI_GATEWAY_BASE_URL=https://api.runable.com/api/gateway/v3/ai
AI_GATEWAY_API_KEY=your-ai-gateway-key

# ── Auth (optional — only if using Runable auth) ──────────────────────────────
BETTER_AUTH_SECRET=generate-with: openssl rand -base64 32
AUTUMN_SECRET_KEY=
RUNABLE_AUTH_ISSUER=
RUNABLE_AUTH_CLIENT_ID=
RUNABLE_AUTH_CLIENT_SECRET=
RUNABLE_URL=
